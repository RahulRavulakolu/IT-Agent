# Set default behavior, in case people don't have core.autocrlf set.
* text=auto

# Ensure shell scripts and config files always have LF line endings
*.sh text eol=lf
Makefile text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf
